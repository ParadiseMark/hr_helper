APP_PORT=3000
APP_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hr_scoring_widget

# OpenAI
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4.1-mini

# amoCRM OAuth (widget credentials)
AMO_CLIENT_ID=your_amo_client_id_here
AMO_CLIENT_SECRET=your_amo_client_secret_here
AMO_REDIRECT_URI=https://your-server.com/integrations/amocrm/callback

# amoCRM custom field IDs (created in amoCRM interface)
AMOCRM_FIELD_AI_SCORE_ID=631523
AMOCRM_FIELD_AI_SCORING_STATUS_ID=631525
AMOCRM_FIELD_AI_HARD_FILTER_STATUS_ID=631527
AMOCRM_FIELD_AI_LAST_SCORED_AT_ID=631529

# hh.ru (not implemented yet)
HH_CLIENT_ID=your_hh_client_id_here
HH_CLIENT_SECRET=your_hh_client_secret_here